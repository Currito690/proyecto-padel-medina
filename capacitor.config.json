{
  "appId": "com.padelmedina.app",
  "appName": "Padel Medina",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#F8FAFC"
  },
  "server": {
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#F8FAFC",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
